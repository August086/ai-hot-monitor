# ============================================================
# 环境变量模板
# 1. 复制为 .env：Windows  copy .env.example .env
#                macOS/Linux  cp .env.example .env
# 2. 填入真实密钥后重启服务
# 3. .env 已被 .gitignore 忽略，请勿提交到 GitHub
# ============================================================

# ===== 服务 =====
PORT=8787
# 数据文件位置（默认 server/data/hotmonitor.db）
# DB_PATH=./data/hotmonitor.db

# ===== 抓取 =====
# 每轮抓取间隔（分钟）
COLLECT_INTERVAL_MINUTES=30
# 单次抓取每个关键词最多取多少条（每个数据源）
PER_KEYWORD_LIMIT=8
# 请求间隔（毫秒），需求要求 5-10 秒，低于 3000 会被强制提升到 3000
CRAWL_DELAY_MS=6000
# 每轮最多处理多少个关键词（防止首轮过载）
MAX_KEYWORDS_PER_RUN=10

# ===== 数据源 =====
# Bing 网页结果普遍没有发布时间，默认关闭；需要时改 true 可回滚
ENABLE_BING=false
ENABLE_HN=true
# arXiv 学术检索与新闻场景不匹配（实测返回数学/物理论文），默认关闭
ENABLE_ARXIV=false
# GDELT 免费接口限流严重（实测 429），默认关闭
ENABLE_GDELT=false
# HuggingFace 在部分网络下不可达，默认关闭；可访问时再打开
ENABLE_HF=false
# 国内科技媒体 RSS（只收命中关键词的条目）
ENABLE_RSS_CN=true
RSS_FEEDS=ithome,solidot,infoq,qbitai
RSS_FRESHNESS_HOURS=48
# 百度资讯（只保留白名单媒体）
ENABLE_BAIDU_NEWS=true
BAIDU_FRESHNESS_HOURS=48
BAIDU_MAX_RESULTS=8
# 覆盖默认白名单（默认已内置 IT之家/36氪/机器之心/量子位/InfoQ/财联社等）
# BAIDU_MEDIA_WHITELIST=IT之家,36氪,机器之心,量子位,InfoQ,财联社

# ===== 质量门槛 =====
# HN：点赞或评论任一达标才入库（当前默认 5 赞 / 2 评论）
HN_MIN_POINTS=5
HN_MIN_COMMENTS=2
# 标题短于该长度直接丢弃
MIN_TITLE_LENGTH=12
# 每轮单源最多入库多少条，防止单一来源刷屏
MAX_ITEMS_PER_SOURCE_PER_RUN=10
# 每轮 AI 预算中单源最多占比（0.4 = 40%）
PER_SOURCE_AI_RATIO=0.4
# GDELT 域名白名单/黑名单（逗号分隔，支持子域名）
# GDELT_DOMAIN_WHITELIST=36kr.com,ithome.com,jiqizhixin.com,techcrunch.com
# GDELT_DOMAIN_BLACKLIST=msn.com,news.google.com,flipboard.com

# 时效过滤（小时）：新闻类 48h，论文 7 天，模型 14 天
FRESHNESS_HOURS=48
ARXIV_FRESHNESS_HOURS=168
HF_FRESHNESS_HOURS=336

# ===== OpenRouter AI =====
OPENROUTER_API_KEY=
# 注意：OpenAI / Anthropic / Gemini 在部分区域会被 OpenRouter 以 403 拒绝，
# 默认使用区域内可用的 DeepSeek 与 Kimi；可按需替换为你的可用模型。
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_FALLBACK_MODEL=moonshotai/kimi-k3
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 无 key 时是否用启发式规则兜底（标记为 heuristic，不冒充 AI 结果）
AI_HEURISTIC_FALLBACK=true
# 每轮最多分析多少条新热点
AI_MAX_ITEMS_PER_RUN=12

# ===== Twitter (twitterapi.io) =====
TWITTERAPI_KEY=
TWITTERAPI_BASE_URL=https://api.twitterapi.io

# ===== 邮件通知 (SMTP) =====
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 默认收件人，可在页面设置里覆盖
MAIL_TO=

# ===== 其他 =====
# 自动分析新热点
AI_AUTO_ANALYZE=true
# 抓取范围描述（会拼进 AI 分析上下文）
MONITOR_SCOPE=AI 编程、大模型、AI 编程工具与开发者生态
